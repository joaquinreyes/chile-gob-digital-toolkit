{
  "name": "chile-gob-digital-toolkit",
  "private": true,
  "version": "0.1.0",
  "description": "Clientes TypeScript para ClaveÚnica (OIDC), FirmaGob y Nodo PISEE 2 del Estado de Chile.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build --workspaces",
    "example:clave-unica": "tsx examples/clave-unica-express/server.ts",
    "example:clave-unica:mock": "tsx examples/clave-unica-express/mock-provider.ts",
    "example:firmagob-sandbox": "tsx examples/firmagob-sandbox/sign-pdf.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "eslint": "^9.17.0",
    "express": "^5.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
