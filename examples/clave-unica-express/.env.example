# Credenciales entregadas por la Secretaría de Gobierno Digital (sandbox, QA o producción).
# No subir este archivo con valores reales.
CLAVEUNICA_CLIENT_ID=
CLAVEUNICA_CLIENT_SECRET=
# Debe coincidir exactamente con una Redirect URI registrada. HTTPS, sin query string, sin localhost.
CLAVEUNICA_REDIRECT_URI=https://mi-app.ejemplo.gob.cl/callback
# Opcional: Logout URI registrada.
CLAVEUNICA_LOGOUT_REDIRECT=
# Opcional: solo para usar el proveedor simulado local (npm run example:clave-unica:mock).
# CLAVEUNICA_BASE_URL=http://localhost:4000
PORT=3000
